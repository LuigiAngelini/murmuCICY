Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mob", "[", "x_", "]"}], "=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{"x", "-", "1"}], ")"}], 
    RowBox[{
     RowBox[{"9", "x"}], "-", "1"}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.9774150510629177`*^9, 3.977415065712471*^9}},
